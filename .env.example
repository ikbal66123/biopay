# Copy these into Vercel → Project → Settings → Environment Variables (never commit real values).

# Supabase (Project Settings → API). The anon key is public by design; RLS protects the data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Never put the service_role key in the browser or in this repo. Not needed by the current code.
# SUPABASE_SERVICE_ROLE_KEY=

# Sentry (Project → Client Keys / DSN). Public by design.
SENTRY_DSN=

# Resend (API Keys). Secret: server-side only.
RESEND_API_KEY=
RECEIPT_FROM="BioPay <struk@mail.yourdomain.com>"
